# Copy to .env and fill in the values.

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Number of proxies in front of the API (e.g. 1 behind Nginx). 0 = none.
TRUST_PROXY=0
# Frontends allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public website — used to build invitation links in e-mails
WEBSITE_URL=http://localhost:3000

# ---- MySQL -----------------------------------------------------------------
DB_HOST=tokaido.proxy.rlwy.net
DB_PORT=46660
DB_USER=root
DB_PASSWORD=LDLWszETJxxWBhVHxFttUFKbGIlZeiYZ
DB_NAME=railway
DB_CONNECTION_LIMIT=100

# ---- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---- Cloudinary (photo uploads) --------------------------------------------
# https://console.cloudinary.com -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=dbcl7zyoy
CLOUDINARY_API_KEY=336651267674643
